class Solution {
    private int[][] dp;
    private int[] suffix;
    private int n;

    public int stoneGameII(int[] piles) {
        n = piles.length;
        dp = new int[n][n + 1];
        suffix = new int[n + 1];
        for (int i = n - 1; i >= 0; i--) {
            suffix[i] = suffix[i + 1] + piles[i];
        }

        return helper(0, 1);
    }

    private int helper(int i, int m) {
        if (i >= n) return 0;
        if (2 * m >= n - i) {
            return suffix[i];
        }
        if (dp[i][m] != 0) return dp[i][m];

        int minOpponent = Integer.MAX_VALUE;
        for (int x = 1; x <= 2 * m; x++) {
            int opponent = helper(i + x, Math.max(m, x));
            minOpponent = Math.min(minOpponent, opponent);
        }

        dp[i][m] = suffix[i] - minOpponent;
        return dp[i][m];
    }
}
